# Copy to .env.local. Values match `npm run db:start` (local Supabase) and the mock on port 9402 (examples/README.md).
APP_URL=http://localhost:3300
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55621
# Local stack's anon key: `npx supabase status`
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# Direct Postgres for the grant store (hosted: the pooler connection string).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55622/postgres

BEXIO_CLIENT_ID=example-client
BEXIO_CLIENT_SECRET=example-secret
BEXIO_ISSUER=http://127.0.0.1:9402/realms/bexio
BEXIO_API_BASE_URL=http://127.0.0.1:9402
BEXIO_SCOPES=contact_show
BEXIO_TOKEN_KEYS={"current":"k1","keys":{"k1":"<npx @soulcode/bexio-oauth keygen>"}}

# Optional, real Bexio only: the Supabase custom provider id for "Sign in with Bexio".
# BEXIO_SUPABASE_PROVIDER=custom:bexio
