# Copy to .env.local. The BEXIO_* values below match the mock started as described in examples/README.md.
APP_URL=http://localhost:3400
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Your Bexio OAuth app. Leave BEXIO_ISSUER / BEXIO_API_BASE_URL empty for real Bexio.
BEXIO_CLIENT_ID=example-client
BEXIO_CLIENT_SECRET=example-secret
BEXIO_ISSUER=http://127.0.0.1:9401/realms/bexio
BEXIO_API_BASE_URL=http://127.0.0.1:9401
BEXIO_SCOPES=contact_show
# npx @soulcode/bexio-oauth keygen
BEXIO_TOKEN_KEYS={"current":"k1","keys":{"k1":"<keygen output>"}}

# Protects the job and cron routes.
CRON_SECRET=change-me
# refreshIdle refreshes connections idle for this long; a real app uses days (7d).
BEXIO_IDLE_FOR=1m

# Test tools for live Bexio accounts (expire, revoke at Bexio) are on; this turns them off.
# BEXIO_TEST_TOOLS=off
