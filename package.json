{
  "name": "bexio-oauth-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.15.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "examples/_shared/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @soulcode/bexio-oauth",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test \"scripts/*.test.mjs\"",
    "test:e2e": "npm run test:e2e --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
